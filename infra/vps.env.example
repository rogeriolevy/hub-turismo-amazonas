# Copy to infra/vps.env on the VPS. Keep the copied file out of Git and restrict it to the operator.
SITE_URL=https://hub.example.com
APP_VERSION=0.12.11
BETTER_AUTH_SECRET=GENERATE_A_RANDOM_URL_SAFE_SECRET_AT_LEAST_32_CHARACTERS
ADMIN_EMAILS=admin@example.com

# Use a real Cloudflare Turnstile widget for the deployed domain.
TURNSTILE_SITE_KEY=REPLACE_WITH_SITE_KEY
TURNSTILE_SECRET_KEY=REPLACE_WITH_SECRET_KEY

POSTGRES_DB=hub_turismo
# Administrative superuser, used by bootstrap and protected backup/restore scripts only.
POSTGRES_USER=hub_postgres_admin
# Generate a high-entropy secret, for example: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_SECRET
# Runtime role owns this database but is not a PostgreSQL superuser.
HUB_DB_USER=hub_app
# Generate a separate URL-safe value, for example: openssl rand -hex 32
HUB_DB_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_HEX_SECRET

# Endpoints de mapa podem ser trocados sem publicar uma nova imagem.
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter

# SMTP transacional; credenciais devem pertencer a um serviço de e-mail autorizado.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Mantém os avisos de reserva dentro do sistema sem e-mail até haver SMTP testado.
BOOKING_EMAIL_NOTIFICATIONS=false
# Preserve o acesso das contas migradas até que todas confirmem seus endereços.
REQUIRE_EMAIL_VERIFICATION=false
