[Unit]
Description=Hub Turismo Amazonas
After=network.target

[Service]
Type=simple
User=hub
Group=hub
WorkingDirectory=/opt/hub-turismo
Environment=NODE_ENV=production
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3005
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
