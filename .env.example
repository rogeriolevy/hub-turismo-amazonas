# Copie somente como referência. npm run setup cria .env.local com segredo aleatório.
SITE_URL=http://127.0.0.1:3005
DATABASE_PATH=./data/hub.sqlite
BETTER_AUTH_SECRET=
ADMIN_EMAILS=rogerio1kg@gmail.com
# Chaves do widget Cloudflare Turnstile. Em npm run dev, o fallback de teste aprova sempre
# e não verifica robôs. Defina chaves reais para validar tráfego; em produção, são obrigatórias.
TURNSTILE_SITE_KEY=0x4AAAAAAFOr1vicXImGvkDJ
TURNSTILE_SECRET_KEY=0x4AAAAAAFOr1saWqQucbBmJnS7NNOonx_8
# Produção atrás do Nginx fornecido: x-real-ip. Deixe vazio no acesso local direto.
TRUST_PROXY_IP_HEADER=
# O fluxo de proximidades consulta Nominatim/Overpass sob demanda e mantém cache local.
# Endpoints podem ser substituídos sem alteração do código, respeitando os limites do provedor.
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter

# E-mail transacional. Sem SMTP, recuperação por e-mail fica desativada.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Ative somente quando o worker de e-mail de reservas estiver configurado.
BOOKING_EMAIL_NOTIFICATIONS=false
# Ative apenas depois que todas as contas existentes confirmarem o endereço.
REQUIRE_EMAIL_VERIFICATION=false
