{
  "name": "hub-turismo-amazonas-node",
  "version": "0.12.13",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "check:version": "node scripts/check-version.mjs",
    "check:vps-release": "node scripts/check-vps-release-version.mjs",
    "check:vps-env": "node --env-file=infra/vps.env scripts/check-vps-env.mjs infra/vps.env package.json",
    "check:architecture": "node scripts/check-architecture-boundaries.mjs",
    "check:migration-immutability": "node scripts/check-migration-immutability.mjs",
    "verify:vps-runtime-image": "node scripts/verify-vps-runtime-image.mjs",
    "verify:vps-source-snapshot": "node scripts/verify-vps-source-snapshot.mjs",
    "verify:vps-release-bundle": "node scripts/verify-vps-release-bundle.mjs",
    "verify:vps-health": "node --env-file=infra/vps.env scripts/verify-vps-health.mjs",
    "notifications:retry-failed": "node --experimental-strip-types scripts/retry-failed-booking-email.ts",
    "check:runtime": "node scripts/check-runtime.mjs",
    "predev": "npm run check:runtime",
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3005",
    "prebuild": "npm run check:runtime",
    "build": "node scripts/build.mjs",
    "prestart": "npm run check:runtime",
    "start": "node scripts/start.mjs",
    "setup": "node scripts/setup.mjs",
    "deploy:vercel": "node scripts/deploy-vercel.mjs",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "db:migrate:postgres": "node --experimental-strip-types scripts/migrate-postgres.ts",
    "db:transfer:postgres": "node --env-file=infra/vps.env --experimental-strip-types scripts/transfer-sqlite-postgres.ts",
    "db:verify-snapshot": "node scripts/compare-sqlite-snapshots.mjs",
    "db:backup": "node --env-file=.env.local --experimental-strip-types scripts/backup.ts",
    "db:restore": "node scripts/restore.mjs",
    "admin:create": "node --env-file=.env.local --experimental-strip-types scripts/admin-create.ts",
    "admin:password": "node --env-file=.env.local --experimental-strip-types scripts/admin-password.ts",
    "account:password": "node --env-file=.env.local --experimental-strip-types scripts/account-password.ts",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:integration": "node --experimental-strip-types tests/integration.ts",
    "qa:preview": "node --experimental-strip-types tests/integration.ts --preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write --ignore-unknown app components/site components/platform lib server db scripts tests docs README.md next.config.ts tsconfig.json package.json .github infra",
    "format:check": "prettier --check --ignore-unknown app components/site components/platform lib server db scripts tests docs README.md next.config.ts tsconfig.json package.json .github infra",
    "cadastur:sync": "node --env-file=.env.local --experimental-strip-types scripts/cadastur-sync.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "@vercel/blob": "2.4.0",
    "better-auth": "1.7.17",
    "better-sqlite3": "12.11.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "csv-parse": "7.0.3",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "read-excel-file": "9.3.10",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "unzipper-esm": "0.13.3",
    "vaul": "^1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "22.19.19",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.9",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
